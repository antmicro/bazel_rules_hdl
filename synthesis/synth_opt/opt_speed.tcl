# Move proc_mux at the end of `yosys proc` to avoid inferred latches.
# See https://github.com/YosysHQ/yosys/issues/3456
# Ideally the bug would be solved in UHDM/Yosys.
yosys proc -nomux
yosys proc_mux

# Remove $print cells.  These cells represent Verilog $display() tasks.
# Some place and route tools cannot handle these in the output Verilog,
# so remove them here.
yosys delete {*/t:$print}

# Remove internal only aliases for public nets and then give created instances
# useful names. At this stage it is mainly flipflops created by the `proc`
# pass.
yosys opt_clean -purge

yosys synth -top $top \
    -noabc \
    -flatten \
    -booth \
    -latches warn

yosys opt_clean -purge

yosys techmap
yosys flatten
yosys clean -purge

# Technology mapping of adders
if {[info exists ::env(ADDER_MAPPING)]} {
  # extract the full adders
  extract_fa
  # map full adders
  techmap -map $adder_mapping
  techmap
  # Quick optimization
  opt -fast -purge
}

# Prepare FF but do not map them yet to PDK cells
# So it can be processed by ABC
dffunmap
dfflibmap -prepare -liberty $stdcell_lib

## Use ABC for sequential optimization and retiming
abc -dff -liberty $stdcell_lib -D $period_ps -script $abc_script -constr $abc_constr -g aig {*}$dont_use_args

## Proper FF mapping this time
yosys dfflibmap -liberty $stdcell_lib
yosys clean -purge

clean
check

setundef -zero
splitnets
opt_clean -purge

# Remove internal only aliases for public nets and then give created instances
# useful names. At this stage it is anything generated by the techmapping
# passes.
yosys opt_clean -purge
