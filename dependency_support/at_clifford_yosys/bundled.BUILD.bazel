"""
Yosys is a framework for RTL synthesis tools. It currently has extensive
Verilog-2005 support and provides a basic set of synthesis algorithms for
various application domains.
"""

load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@bison//:bison.bzl", "bison")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_flex//flex:flex.bzl", "flex")
load("@rules_hdl//dependency_support:copy.bzl", "copy")
load("@rules_python//python:defs.bzl", "py_binary")

licenses(["notice"])

exports_files(["COPYING"])

VERSION = "0.70"

YOSYS_COPTS = [
    "-std=c++20",
    "-w",
]

write_file(
    name = "version_src",
    out = "kernel/version.cc",
    content = [
        "namespace Yosys {",
        'const char *yosys_version_str = "Yosys %s (Bazel)";' % VERSION,
        'const char *yosys_git_hash_str = "v%s";' % VERSION,
        'const char *yosys_build_datetime_str = "Bazel";',
        "}",
    ],
)

cc_library(
    name = "version",
    srcs = ["kernel/version.cc"],
    visibility = ["//visibility:public"],
)

# Yosys locates share/ beside its executable before using YOSYS_DATDIR.
write_file(
    name = "yosys_config_header",
    out = "kernel/yosys_config.h",
    content = [
        "#pragma once",
        '#define YOSYS_PROGRAM_PREFIX ""',
        '#define YOSYS_DATDIR "./"',
        "#define YOSYS_ENABLE_GLOB",
        "#define YOSYS_ENABLE_SPAWN",
        "#define YOSYS_ENABLE_THREADS",
        "#define YOSYS_ENABLE_DLOPEN",
        "#define YOSYS_ENABLE_ZLIB",
        "#define YOSYS_ENABLE_LIBFFI",
        "#define YOSYS_ENABLE_PLUGINS",
        "#define YOSYS_ENABLE_READLINE",
        "#define YOSYS_ENABLE_TCL",
    ],
)

flex(
    name = "verilog_lexer_internal",
    src = "frontends/verilog/verilog_lexer.l",
)

filegroup(
    name = "verilog_lexer_src",
    srcs = [":verilog_lexer_internal"],
    output_group = "cc_srcs",
)

copy(
    name = "verilog_lexer_cc",
    src = ":verilog_lexer_src",
    out = "frontends/verilog/verilog_lexer.cc",
)

# The C++ parser requires Bison >= 3.6.
bison(
    name = "verilog_parser",
    srcs = ["frontends/verilog/verilog_parser.y"],
    outs = [
        "frontends/verilog/verilog_parser.tab.cc",
        "frontends/verilog/verilog_parser.tab.hh",
    ],
    args = [
        "-o",
        "$(execpath frontends/verilog/verilog_parser.tab.cc)",
        "-d",
        "$(execpath frontends/verilog/verilog_parser.y)",
    ],
)

py_binary(
    name = "cellhelp",
    srcs = ["kernel/cellhelp.py"],
)

[genrule(
    name = "%s_help" % lib,
    srcs = ["techlibs/common/%s.v" % lib],
    outs = ["kernel/%s_help.inc" % lib],
    cmd = "$(location :cellhelp) $(SRCS) > $@",
    tools = [":cellhelp"],
) for lib in [
    "simlib",
    "simcells",
]]

py_binary(
    name = "pmgen",
    srcs = ["passes/pmgen/pmgen.py"],
)

PMGEN_SRCS = glob([
    "passes/pmgen/*.pmg",
    "techlibs/**/*.pmg",
])

[genrule(
    name = pmg.replace("/", "_").removesuffix(".pmg") + "_pm",
    srcs = [pmg],
    outs = [pmg.removesuffix(".pmg") + "_pm.h"],
    cmd = "$(location :pmgen) -o $@ $<",
    tools = [":pmgen"],
) for pmg in PMGEN_SRCS]

# Peepopt patterns share a single matcher.
genrule(
    name = "peepopt_pm",
    srcs = glob(["passes/opt/peepopt_*.pmg"]),
    outs = ["passes/opt/peepopt_pm.h"],
    cmd = "$(location :pmgen) -o $@ -p peepopt $(SRCS)",
    tools = [":pmgen"],
)

cc_library(
    name = "kernel",
    srcs = glob(
        [
            "kernel/*.cc",
            "backends/**/*.cc",
            "frontends/**/*.cc",
            "passes/**/*.cc",
            "techlibs/**/*.cc",
        ],
        exclude = [
            "kernel/driver.cc",
            # Requires Verific.
            "kernel/log_compat.cc",
            "frontends/verific/verificsva.cc",
            # Standalone tool.
            "passes/techmap/filterlib.cc",
            "backends/cxxrtl/runtime/**",
            # Compiled by :frontend_slang.
            "frontends/slang/**",
        ],
    ) + [
        "kernel/simcells_help.inc",
        "kernel/simlib_help.inc",
        "passes/opt/peepopt_pm.h",
        ":verilog_lexer_cc",
        ":verilog_parser",
    ] + [pmg.removesuffix(".pmg") + "_pm.h" for pmg in PMGEN_SRCS],
    hdrs = glob(
        [
            "kernel/*.h",
            "kernel/*.inc",
            "backends/**/*.h",
            "frontends/**/*.h",
            "passes/**/*.h",
            "techlibs/**/*.h",
            "libs/cxxopts/include/*.hpp",
            "libs/flex/*.h",
            "libs/symfpu/**/*.h",
        ],
        exclude = [
            "backends/cxxrtl/runtime/**",
            "frontends/slang/**",
        ],
    ) + ["kernel/yosys_config.h"],
    copts = YOSYS_COPTS,
    defines = [
        "_YOSYS_",
        "YOSYS_ENABLE_ABC",
        'ABCEXTERNAL=\\"abc\\"',
    ],
    features = ["-use_header_modules"],
    includes = [
        ".",
        "libs",
        "libs/flex",
    ],
    linkopts = [
        "-lpthread",
        "-ldl",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":bigint",
        ":ezsat",
        ":fst",
        ":json11",
        ":sha1",
        ":subcircuit",
        "@libffi",
        "@readline",
        "@tcl_lang//:tcl",
        "@zlib",
    ],
    alwayslink = True,
)

cc_binary(
    name = "yosys",
    srcs = ["kernel/driver.cc"],
    copts = YOSYS_COPTS,
    data = [
        ":share_files",
        "@abc//:abc_bin",
        "@tcl_lang//:tcl_core",
    ],
    features = ["-use_header_modules"],
    # Plugins resolve yosys symbols from the executable.
    linkopts = ["-rdynamic"],
    visibility = ["//visibility:public"],
    deps = [
        ":fmt",
        ":frontend_slang",
        ":kernel",
        ":version",
    ],
)

expand_template(
    name = "sv_elab_version",
    out = "frontends/slang/version.h",
    substitutions = {
        "@SLANG_REVISION@": "yosys-" + VERSION,
        "@YOSYS_SLANG_REVISION@": "yosys-" + VERSION,
    },
    template = "frontends/slang/lib/src/version.h.in",
)

cc_library(
    name = "frontend_slang",
    srcs = glob(["frontends/slang/lib/src/**/*.cc"]),
    hdrs = glob([
        "frontends/slang/lib/src/**/*.h",
        "frontends/slang/lib/third_party/hashlib/*.h",
    ]) + ["frontends/slang/version.h"],
    copts = YOSYS_COPTS,
    features = ["-use_header_modules"],
    includes = [
        "frontends/slang",
        "frontends/slang/lib/src",
        "frontends/slang/lib/src/yosys_plugin",
        "frontends/slang/lib/third_party/hashlib",
    ],
    local_defines = [
        "YOSYS_MAJOR=" + VERSION.split(".")[0],
        "YOSYS_MINOR=" + VERSION.split(".")[1],
        "YOSYS_COMMIT=0",
    ],
    deps = [
        ":kernel",
        ":slang",
    ],
    alwayslink = True,
)

expand_template(
    name = "slang_version",
    out = "libs/slang/gen/VersionInfo.cpp",
    substitutions = {
        "@SLANG_VERSION_HASH@": "yosys-" + VERSION,
        "@SLANG_VERSION_MAJOR@": "12",
        "@SLANG_VERSION_MINOR@": "0",
        "@SLANG_VERSION_PATCH@": "0",
        "@SLANG_VERSION_PRERELEASE@": "",
    },
    template = "libs/slang/source/util/VersionInfo.cpp.in",
)

write_file(
    name = "slang_export",
    out = "libs/slang/gen/slang/slang_export.h",
    content = [
        "#pragma once",
        "#define SLANG_EXPORT",
        "#define SLANG_NO_EXPORT",
    ],
)

SLANG_DIAGS = [
    "AllDiags",
    "AnalysisDiags",
    "CompilationDiags",
    "ConstEvalDiags",
    "DeclarationsDiags",
    "DriverDiags",
    "ExpressionsDiags",
    "GeneralDiags",
    "LexerDiags",
    "LookupDiags",
    "MetaDiags",
    "NumericDiags",
    "ParserDiags",
    "PreprocessorDiags",
    "StatementsDiags",
    "SysFuncsDiags",
    "TypesDiags",
]

genrule(
    name = "slang_diagnostics",
    srcs = glob([
        "libs/slang/scripts/*",
        "libs/slang/source/**",
        "libs/slang/include/**",
    ]),
    outs = ["libs/slang/gen/DiagCode.cpp"] + ["libs/slang/gen/slang/diagnostics/%s.h" % d for d in SLANG_DIAGS],
    cmd = """
        $(PYTHON3) $(execpath libs/slang/scripts/diagnostic_gen.py) \
            --outDir $(RULEDIR)/libs/slang/gen \
            --diagnostics $(execpath libs/slang/scripts/diagnostics.txt)
    """,
    toolchains = ["@rules_python//python:current_py_toolchain"],
)

genrule(
    name = "slang_syntax",
    srcs = glob(["libs/slang/scripts/*"]),
    outs = ["libs/slang/gen/" + f for f in [
        "AllSyntax.cpp",
        "KnownSystemName.cpp",
        "SyntaxClone.cpp",
        "TokenKind.cpp",
        "slang/parsing/KnownSystemName.h",
        "slang/parsing/TokenKind.h",
        "slang/syntax/AllSyntax.h",
        "slang/syntax/CSTJsonVisitorGen.h",
        "slang/syntax/SyntaxFwd.h",
        "slang/syntax/SyntaxKind.h",
    ]],
    cmd = "$(PYTHON3) $(execpath libs/slang/scripts/syntax_gen.py) --dir $(RULEDIR)/libs/slang/gen --syntax $(execpath libs/slang/scripts/syntax.txt)",
    toolchains = ["@rules_python//python:current_py_toolchain"],
)

cc_library(
    name = "slang",
    srcs = glob([
        "libs/slang/source/**/*.cpp",
        "libs/slang/source/**/*.h",
    ]) + [
        ":slang_diagnostics",
        ":slang_syntax",
        ":slang_version",
    ],
    hdrs = glob([
        "libs/slang/include/**/*.h",
        "libs/slang/external/**",
    ]) + [":slang_export"],
    copts = YOSYS_COPTS,
    defines = [
        "SLANG_USE_THREADS",
        "SLANG_STATIC_DEFINE",
    ],
    includes = [
        "libs/slang/external",
        "libs/slang/gen",
        "libs/slang/include",
    ],
    local_defines = ["BOOST_REGEX_STANDALONE"],
    deps = [
        ":fmt",
        ":slang_third_party",
    ],
)

cc_library(
    name = "slang_third_party",
    hdrs = glob([
        "libs/boost_regex/include/**",
        "libs/tomlplusplus/include/toml++/**",
    ]),
    includes = [
        "libs/boost_regex/include",
        "libs/tomlplusplus/include",
    ],
)

# Slang provides the fmt implementation in util/Fmt.cpp.
cc_library(
    name = "fmt",
    hdrs = glob(["libs/fmt/include/fmt/*.h"]),
    includes = ["libs/fmt/include"],
)

py_binary(
    name = "make_lut_tree_lib",
    srcs = ["techlibs/gatemate/make_lut_tree_lib.py"],
)

genrule(
    name = "gatemate_lut_tree",
    outs = [
        "techlibs/gatemate/lut_tree_cells.genlib",
        "techlibs/gatemate/lut_tree_map.v",
    ],
    # The script writes both files into the working directory.
    cmd = "$(location :make_lut_tree_lib) && mv $$(basename -a $(OUTS)) $(RULEDIR)/techlibs/gatemate/",
    tools = [":make_lut_tree_lib"],
)

py_binary(
    name = "generate_bram_types_sim",
    srcs = ["techlibs/quicklogic/qlf_k6n10f/generate_bram_types_sim.py"],
)

genrule(
    name = "quicklogic_bram_types_sim",
    outs = ["techlibs/quicklogic/qlf_k6n10f/bram_types_sim.v"],
    cmd = "$(location :generate_bram_types_sim) $@",
    tools = [":generate_bram_types_sim"],
)

# Install runtime data beside yosys. Common techlibs live directly in share/;
# device libraries retain their subdirectories. Generated files need explicit
# entries because glob() only finds source files.
SHARE_FILES = {
    src.replace("techlibs/common/", "share/").replace("techlibs/", "share/"): src
    for src in glob(
        ["techlibs/**/*." + ext for ext in ["v", "vh", "txt", "lib", "genlib"]],
        exclude = ["**/CMakeLists.txt", "**/tests/**"],
        allow_empty = True,
    ) + [
        "techlibs/gatemate/lut_tree_cells.genlib",
        "techlibs/gatemate/lut_tree_map.v",
        "techlibs/quicklogic/qlf_k6n10f/bram_types_sim.v",
    ]
}

SHARE_FILES["share/sdc/graph-stubs.sdc"] = "passes/cmds/sdc/graph-stubs.sdc"

[copy(
    name = dst.replace("/", "_"),
    src = src,
    out = dst,
) for dst, src in SHARE_FILES.items()]

filegroup(
    name = "share_files",
    srcs = SHARE_FILES.keys(),
    visibility = ["//visibility:public"],
)

genrule(
    name = "testing_yosys_syntax_check_build_rule",
    srcs = [
        "examples/cmos/cmos_cells.v",
        "examples/cmos/counter.v",
    ],
    outs = ["syntax_check.log"],
    cmd = "$(location :yosys) -Q -T -p 'read_verilog -sv $(SRCS)' 2>&1 | tee $@",
    tools = [":yosys"],
)

