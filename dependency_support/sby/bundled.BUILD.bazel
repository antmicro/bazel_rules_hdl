"""SBY, the Yosys formal verification frontend."""

load("@rules_hdl_pip_deps_to_vendor//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary")

licenses(["notice"])

exports_files(["COPYING"])

genrule(
    name = "sby_version",
    srcs = [
        ".gittag",
        "sbysrc/sby.py",
    ],
    outs = ["sbysrc/sby_main.py"],
    cmd = """sed "s/##yosys-release-version##/release_version = 'SBY $$(cat $(location .gittag))'/" $(location sbysrc/sby.py) > $@""",
)

py_binary(
    name = "sby",
    srcs = glob(
        ["sbysrc/*.py"],
        exclude = ["sbysrc/sby.py"],
    ) + ["sbysrc/sby_main.py"],
    data = [
        "@at_clifford_yosys//:yosys",
        "@at_clifford_yosys//:yosys_witness",
    ],
    imports = ["sbysrc"],
    main = "sbysrc/sby_main.py",
    visibility = ["//visibility:public"],
    deps = [requirement("click")],
)
